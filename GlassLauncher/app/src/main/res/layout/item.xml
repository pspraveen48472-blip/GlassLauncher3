<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp" android:layout_height="wrap_content"
    android:layout_marginEnd="20dp" android:orientation="vertical" android:gravity="center_horizontal"
    android:focusable="true" android:clickable="true" android:padding="20dp">
    <ImageView android:id="@+id/icon" android:layout_width="88dp" android:layout_height="88dp" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center" android:singleLine="true"
        android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="15sp" />
</LinearLayout>
